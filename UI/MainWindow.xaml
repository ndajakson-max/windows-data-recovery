<Window x:Class="WindowsDataRecovery.UI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Windows Data Recovery Tool" Height="700" Width="1000"
        WindowStartupLocation="CenterScreen"
        Icon="../Assets/recovery-icon.ico"
        Background="#F5F5F5">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0" Background="{StaticResource PrimaryBrush}" Padding="20" Orientation="Vertical">
            <TextBlock Text="Windows Data Recovery Tool" FontSize="24" FontWeight="Bold" Foreground="White"/>
            <TextBlock Text="Recover your deleted files from Windows-formatted disks" FontSize="12" Foreground="#E0E0E0" Margin="0,5,0,0"/>
        </StackPanel>

        <!-- Main Content -->
        <TabControl Grid.Row="1" Margin="10">
            <!-- Scan Tab -->
            <TabItem Header="Scan Drive" Padding="10,5">
                <Grid Background="White" Margin="10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Margin="0,0,0,20">
                        <TextBlock Text="Step 1: Select Drive to Scan" FontSize="14" FontWeight="Bold" Margin="0,0,0,10"/>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                            <ComboBox x:Name="DriveComboBox" Width="300" Height="35" FontSize="12" VerticalContentAlignment="Center"/>
                            <Button Content="Refresh" Width="80" Height="35" Margin="10,0,0,0" Click="RefreshDrives_Click" Background="{StaticResource PrimaryBrush}" Foreground="White"/>
                        </StackPanel>
                    </StackPanel>

                    <GroupBox Grid.Row="1" Header="Scan Options" Padding="10" Margin="0,0,0,20">
                        <StackPanel>
                            <CheckBox x:Name="DeepScanCheckBox" Content="Deep Scan (slower but more thorough)" Margin="0,5" IsChecked="False"/>
                            <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                                <TextBlock Text="File Types (comma-separated):" VerticalAlignment="Center" Width="200"/>
                                <TextBox x:Name="FileTypesTextBox" Width="300" Height="30" Padding="5"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                                <TextBlock Text="Minimum File Size (KB):" VerticalAlignment="Center" Width="200"/>
                                <TextBox x:Name="MinFileSizeTextBox" Width="100" Height="30" Padding="5" Text="0"/>
                            </StackPanel>
                        </StackPanel>
                    </GroupBox>

                    <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,0,0,20">
                        <Button x:Name="StartScanButton" Content="Start Scan" Width="120" Height="40" Click="StartScan_Click" Background="{StaticResource SuccessBrush}" Foreground="White" FontWeight="Bold"/>
                        <Button x:Name="CancelScanButton" Content="Cancel" Width="120" Height="40" Margin="10,0,0,0" Click="CancelScan_Click" Background="{StaticResource ErrorBrush}" Foreground="White" IsEnabled="False"/>
                    </StackPanel>

                    <Grid Grid.Row="3">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <ProgressBar x:Name="ScanProgressBar" Grid.Row="0" Height="20" Margin="0,0,0,10" Foreground="{StaticResource SuccessBrush}"/>
                        <TextBlock x:Name="ScanStatusText" Grid.Row="1" Text="Ready to scan" Margin="0,0,0,10" FontSize="12"/>
                        
                        <ListBox x:Name="FilesListBox" Grid.Row="2" Background="#FAFAFA" BorderThickness="1" BorderBrush="#DDD" MouseDoubleClick="FileItem_DoubleClick">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal" Padding="5">
                                        <CheckBox IsChecked="{Binding IsSelected}" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock Text="{Binding FileName}" FontWeight="Bold"/>
                                            <TextBlock Text="{Binding FormattedSize}" FontSize="11" Foreground="#666"/>
                                        </StackPanel>
                                    </StackPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </Grid>
                </Grid>
            </TabItem>

            <!-- Recovery Tab -->
            <TabItem Header="Recover Files" Padding="10,5">
                <Grid Background="White" Margin="10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Text="Step 2: Recover Selected Files" FontSize="14" FontWeight="Bold" Margin="0,0,0,20"/>

                    <GroupBox Grid.Row="1" Header="Recovery Destination" Padding="10" Margin="0,0,0,20">
                        <StackPanel>
                            <TextBlock Text="Select where to save recovered files:" Margin="0,0,0,10"/>
                            <StackPanel Orientation="Horizontal">
                                <TextBox x:Name="DestinationPathTextBox" Width="500" Height="35" IsReadOnly="True" Padding="5" Background="#F9F9F9"/>
                                <Button Content="Browse" Width="100" Height="35" Margin="10,0,0,0" Click="BrowseDestination_Click" Background="{StaticResource PrimaryBrush}" Foreground="White"/>
                            </StackPanel>
                        </StackPanel>
                    </GroupBox>

                    <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,0,0,20">
                        <Button x:Name="StartRecoveryButton" Content="Start Recovery" Width="120" Height="40" Click="StartRecovery_Click" Background="{StaticResource SuccessBrush}" Foreground="White" FontWeight="Bold" IsEnabled="False"/>
                        <Button x:Name="CancelRecoveryButton" Content="Cancel" Width="120" Height="40" Margin="10,0,0,0" Click="CancelRecovery_Click" Background="{StaticResource ErrorBrush}" Foreground="White" IsEnabled="False"/>
                    </StackPanel>

                    <Grid Grid.Row="3">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <ProgressBar x:Name="RecoveryProgressBar" Grid.Row="0" Height="20" Margin="0,0,0,10" Foreground="{StaticResource SuccessBrush}"/>
                        <TextBlock x:Name="RecoveryStatusText" Grid.Row="1" Text="Ready to recover" Margin="0,0,0,10" FontSize="12"/>
                        
                        <GroupBox Grid.Row="2" Header="Recovery Summary" Padding="10" Margin="0,0,0,10">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="Files Recovered" FontWeight="Bold" Margin="0,0,0,5"/>
                                    <TextBlock x:Name="FilesRecoveredText" Text="0" FontSize="16" Foreground="{StaticResource SuccessBrush}"/>
                                </StackPanel>
                                <StackPanel Grid.Column="1">
                                    <TextBlock Text="Data Recovered" FontWeight="Bold" Margin="0,0,0,5"/>
                                    <TextBlock x:Name="DataRecoveredText" Text="0 B" FontSize="16" Foreground="{StaticResource SuccessBrush}"/>
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="Success Rate" FontWeight="Bold" Margin="0,0,0,5"/>
                                    <TextBlock x:Name="SuccessRateText" Text="0%" FontSize="16" Foreground="{StaticResource SuccessBrush}"/>
                                </StackPanel>
                            </Grid>
                        </GroupBox>

                        <ListBox x:Name="RecoveryListBox" Grid.Row="3" Background="#FAFAFA" BorderThickness="1" BorderBrush="#DDD">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal" Padding="5">
                                        <TextBlock Text="{Binding FileName}" Width="300"/>
                                        <TextBlock Text="{Binding RecoveryStatus}" Width="100" Foreground="#666"/>
                                        <TextBlock Text="{Binding FormattedSize}" Foreground="#999"/>
                                    </StackPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </Grid>
                </Grid>
            </TabItem>

            <!-- Settings Tab -->
            <TabItem Header="Settings" Padding="10,5">
                <Grid Background="White" Margin="10">
                    <StackPanel Orientation="Vertical">
                        <GroupBox Header="Application Settings" Padding="10" Margin="0,0,0,20">
                            <StackPanel>
                                <CheckBox Content="Enable detailed logging" Margin="0,5" IsChecked="True"/>
                                <CheckBox Content="Verify recovered files" Margin="0,5" IsChecked="True"/>
                                <CheckBox Content="Show confirmation dialogs" Margin="0,5" IsChecked="True"/>
                            </StackPanel>
                        </GroupBox>

                        <GroupBox Header="Advanced Options" Padding="10" Margin="0,0,0,20">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,5">
                                    <TextBlock Text="Scan Timeout (minutes):" Width="200" VerticalAlignment="Center"/>
                                    <TextBox Width="100" Height="30" Padding="5" Text="60"/>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                                    <TextBlock Text="Recovery Threads:" Width="200" VerticalAlignment="Center"/>
                                    <TextBox Width="100" Height="30" Padding="5" Text="4"/>
                                </StackPanel>
                            </StackPanel>
                        </GroupBox>

                        <Button Content="View Logs" Width="100" Height="35" Click="ViewLogs_Click" Background="{StaticResource PrimaryBrush}" Foreground="White"/>
                    </StackPanel>
                </Grid>
            </TabItem>
        </TabControl>

        <!-- Footer -->
        <StackPanel Grid.Row="2" Background="#F5F5F5" Padding="15" Orientation="Horizontal">
            <TextBlock Text="Windows Data Recovery Tool v1.0.0" VerticalAlignment="Center" Foreground="#666"/>
            <TextBlock Text=" | " VerticalAlignment="Center" Foreground="#CCC" Margin="10,0"/>
            <TextBlock Text="Always run as Administrator" VerticalAlignment="Center" Foreground="#F44336" FontWeight="Bold"/>
        </StackPanel>
    </Grid>
</Window>